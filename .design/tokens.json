{
  "version": "1.0.0",
  "colors": {
    "primary": "#2C4A63",
    "primaryHover": "#1F3648",
    "secondary": "#6E6A62",
    "accent": "#2C4A63",
    "background": "#FBFAF7",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F4F2EC",
    "error": "#A62B1F",
    "warning": "#C8442C",
    "success": "#2F6B57",
    "textPrimary": "#1A1917",
    "textSecondary": "#6E6A62",
    "textDisabled": "#A29D93",
    "border": "#E4E0D7",
    "focusRing": "#2C4A63"
  },
  "typography": {
    "headingFont": "\"Hiragino Mincho ProN\", \"HiraMinProN-W3\", \"Yu Mincho\", \"YuMincho\", \"BIZ UDPMincho\", \"Noto Serif JP\", \"Source Han Serif JP\", serif",
    "bodyFont": "\"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", \"Yu Gothic\", \"YuGothic\", \"BIZ UDPGothic\", \"Noto Sans JP\", \"Meiryo\", sans-serif",
    "codeFont": "\"SFMono-Regular\", \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", \"Liberation Mono\", monospace",
    "scale": {
      "display": {
        "fontKey": "headingFont",
        "size": 38,
        "weight": 400,
        "lineHeight": 1.45,
        "letterSpacing": "0.04em"
      },
      "h1": {
        "fontKey": "headingFont",
        "size": 30,
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0.03em"
      },
      "h2": {
        "fontKey": "headingFont",
        "size": 24,
        "weight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0.02em"
      },
      "h3": {
        "fontKey": "bodyFont",
        "size": 18,
        "weight": 700,
        "lineHeight": 1.6
      },
      "h4": {
        "fontKey": "bodyFont",
        "size": 16,
        "weight": 700,
        "lineHeight": 1.6
      },
      "body": {
        "fontKey": "bodyFont",
        "size": 16,
        "weight": 400,
        "lineHeight": 1.85
      },
      "bodySmall": {
        "fontKey": "bodyFont",
        "size": 14,
        "weight": 400,
        "lineHeight": 1.8
      },
      "caption": {
        "fontKey": "bodyFont",
        "size": 13,
        "weight": 400,
        "lineHeight": 1.7,
        "letterSpacing": "0.02em"
      },
      "code": {
        "fontKey": "codeFont",
        "size": 14,
        "weight": 400,
        "lineHeight": 1.7
      }
    }
  },
  "spacing": {
    "baseUnit": 8,
    "scale": [4, 8, 12, 16, 24, 32, 48, 64],
    "maxContentWidth": 768,
    "gridColumns": 1,
    "gridGap": 0,
    "sectionSpacing": 48
  },
  "components": {
    "buttons": {
      "borderRadius": 3,
      "paddingY": 10,
      "paddingX": 20,
      "variants": {
        "primary": {
          "background": "#2C4A63",
          "color": "#FBFAF7",
          "border": "none"
        },
        "secondary": {
          "background": "transparent",
          "color": "#2C4A63",
          "border": "1px solid #2C4A63"
        },
        "ghost": {
          "background": "transparent",
          "color": "#1A1917",
          "border": "none"
        },
        "destructive": {
          "background": "#A62B1F",
          "color": "#FBFAF7",
          "border": "none"
        }
      },
      "states": {
        "hover": "背景を primaryHover へ、または地を surface へ抜く。opacity の変更だけで済ませない",
        "focus": "focusRing 2px、offset 2px のリング（:focus-visible）",
        "active": "translateY(1px) で 1px 沈める",
        "disabled": "textDisabled の文字、cursor: not-allowed"
      }
    },
    "cards": {
      "borderRadius": 2,
      "background": "colors.surface",
      "border": "1px solid #E4E0D7",
      "shadow": "depth.flat",
      "padding": 24
    },
    "inputs": {
      "borderRadius": 3,
      "border": "1px solid #E4E0D7",
      "paddingY": 10,
      "paddingX": 12,
      "focusBorder": "colors.primary",
      "focusShadow": "0 0 0 2px rgba(44,74,99,0.18)",
      "errorBorder": "colors.error",
      "placeholder": "colors.textDisabled"
    },
    "navigation": {
      "style": "縦積みリスト。通し番号を本文カラムの左外にぶら下げる（ハンギング）",
      "background": "colors.background",
      "activeStyle": "left rail を 4px から 6px へ伸長 + 地を surface へ白抜き + 番号を primary へ",
      "itemPadding": "12px 0"
    }
  },
  "depth": {
    "flat": {
      "shadow": "none",
      "usage": "既定。閉じたカード、索引、本文。1px ボーダーで区切る"
    },
    "raised": {
      "shadow": "0 1px 2px rgba(26,25,23,0.06)",
      "usage": "展開中のグループカードのみ。今フォーカスしている 1 枚を示す"
    },
    "overlay": {
      "shadow": "0 4px 12px rgba(26,25,23,0.10)",
      "usage": "ポップオーバー（MVP 未使用）"
    },
    "modal": {
      "shadow": "0 12px 32px rgba(26,25,23,0.14)",
      "usage": "モーダル（MVP 未使用）"
    },
    "toast": {
      "shadow": "0 8px 24px rgba(26,25,23,0.16)",
      "usage": "トースト（MVP 未使用）"
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": {
        "name": "Mobile",
        "minWidth": 0,
        "behavior": "単一カラム。番号ハンギングを解除し番号を見出し行の先頭へ戻す。左余白 16px"
      },
      "md": {
        "name": "Tablet",
        "minWidth": 640,
        "behavior": "本文行長が 42rem に届くまで自然に伸長。左余白 32px"
      },
      "lg": {
        "name": "Desktop",
        "minWidth": 1024,
        "behavior": "ページコンテナ 768px で中央寄せ。番号ハンギングが有効化される"
      },
      "xl": {
        "name": "Wide",
        "minWidth": 1280,
        "behavior": "lg と同一。行長を守るためコンテナをこれ以上広げない"
      }
    },
    "touchTarget": 44,
    "approach": "mobile-first",
    "collapseStrategy": "索引と詳細は元から縦積みのため構造変化を起こさない。コードブロックのみ横スクロールで退避し、ページ本体は横スクロールさせない"
  }
}
