#!/bin/sh
# pre-push ゲート: CI と同一のチェックを push 前にローカルで実行する。
# 有効化（clone ごとに 1 回）: git config core.hooksPath githooks
# 緊急時のバイパス: git push --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

# git は hook へ GIT_DIR を渡す。worktree ではこれが絶対パスになるため、検証中の
# `git init` / `git check-ignore`（cwd = 一時ディレクトリ）が一時リポジトリではなく
# 本物のリポジトリを操作してしまう。通常 checkout では相対パス `.git` が cwd 基準で
# 解決されて偶然動くだけで、cwd を渡す実装だけでは防げない。継承を明示的に断ち切る。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# translation parity の比較元に、push ネゴシエーションで得た remote の現在地を渡す。
# git は pre-push の stdin へ `<local ref> <local sha> <remote ref> <remote sha>` を
# 与える。この remote sha は今まさに remote と交渉して得た値なので、fetch していない
# 作業ディレクトリでも正確である。remote-tracking ref をそのまま使うと、fetch 漏れの
# 分だけマージ済みの翻訳が「これから入る翻訳」として再検出され、偽 BLOCK になる。
#
# 新規ブランチの push では remote sha が全 0 になる。その場合は指定せず、
# check_translation_parity.py 側の候補連鎖と鮮度検査に委ねる。
while read -r _local_ref _local_sha _remote_ref remote_sha; do
  case "${remote_sha:-}" in
    *[!0]*) ;;      # 0 以外の文字を含む = 実在する remote の tip
    *) continue ;;  # 空文字 / 全 0 = remote にまだ存在しないブランチ
  esac
  if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    TRANSLATION_PARITY_BASELINE="$remote_sha"
    export TRANSLATION_PARITY_BASELINE
    break
  fi
done

exec sh scripts/run_checks.sh
